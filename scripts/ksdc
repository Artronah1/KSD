        echo "  $(t ops_logs)"
        echo "  $(t ops_restart)"
        echo "  $(t ops_removeall)"
        echo "  0) $(t back)"
        read -r -p "$(tf choice_prompt 10)" opt
        case "$opt" in
            1) clear; $KSD status -config "$CONFIG"; echo; read -r -p "$(t press_enter)" d ;;
            2) clear; $KSD self-test -config "$CONFIG"; echo; read -r -p "$(t press_enter)" d ;;
            3) clear; $KSD dry-run full -config "$CONFIG"; echo; read -r -p "$(t press_enter)" d ;;
            4) clear; $KSD dry-run baseline -config "$CONFIG"; echo; read -r -p "$(t press_enter)" d ;;
            5) clear; $KSD install -config "$CONFIG"; echo; read -r -p "$(t press_enter)" d ;;
            6) clear; $KSD reset-counters -config "$CONFIG"; echo; read -r -p "$(t press_enter)" d ;;
            7) show_artifact_info ;;
            8) clear; logread | grep -iE 'ksd' | tail -60; echo; read -r -p "$(t press_enter)" d ;;
            9) clear; $INIT restart; echo "${GREEN}$(t restart_ok)${RESET}"; sleep 2; $KSD status -config "$CONFIG" | head -8; echo; read -r -p "$(t press_enter)" d ;;
            10)
                echo "${RED}$(t ops_warn_rm)${RESET}"
                read -r -p "$(t confirm)" c
                case "$c" in y|Y) $KSD remove-all -config "$CONFIG" ;; *) echo "$(t cancelled)" ;; esac
                echo; read -r -p "$(t press_enter)" d ;;
            0) break ;;
        esac
    done
}

# ─── Выбор языка ────────────────────────────────────────

menu_lang() {
    clear
    echo "${BOLD}$(t lang_title)${RESET}"
    echo ""
    echo "  1) English"
    echo "  2) Русский"
    echo "  3) 中文"
    echo "  0) $(t back)"
    read -r -p "$(tf choice_prompt 3)" opt
    case "$opt" in
        1) UI_LANG="en" ;;
        2) UI_LANG="ru" ;;
        3) UI_LANG="zh" ;;
        *) return ;;
    esac
    if printf '%s\n' "$UI_LANG" > "$LANG_FILE" 2>/dev/null; then
        echo "${GREEN}$(tf lang_saved "$(lang_name "$UI_LANG")")${RESET}"
    else
        echo "${YELLOW}$(tf lang_saved "$(lang_name "$UI_LANG")")${RESET}"
        echo "${YELLOW}$(t lang_save_failed)${RESET}"
    fi
    sleep 1
}

# ─── Применение ─────────────────────────────────────────

apply_and_restart() {
    clear
    echo "${BOLD}$(t apply_title)${RESET}"
    uci commit killswitch
    echo "${DIM}$(t restarting)${RESET}"
    $INIT restart
    sleep 2
    echo ""
    $KSD status -config "$CONFIG" | head -12
    echo ""
    read -r -p "$(t press_enter)" d
}

main_menu() {
    while true; do
        clear
        echo "${BOLD}$(t menu_title)${RESET}"
        echo ""
        echo "  $(t mm_show)"
        echo "  $(t mm_basic)"
        echo "  $(t mm_network)"
        echo "  $(t mm_timing)"
        echo "  $(t mm_dns)"
        echo "  $(t mm_arp)"
        echo "  $(t mm_logs)"
        echo "  $(t mm_lists)"
        echo "  $(t mm_ops)"
        echo "  $(t mm_apply)"
        echo "  $(t mm_showuci)"
        echo "  $(t mm_artifact)"
        echo "  $(t mm_lang)"
        echo "  $(t mm_exit)"
        echo ""
        read -r -p "$(tf choice_prompt 13)" choice
        case "$choice" in
            1) show_config; read -r -p "$(t press_enter)" d ;;
            2) menu_basic ;;
            3) menu_network ;;
            4) menu_timing ;;
            5) menu_dns ;;
            6) menu_arp ;;
            7) menu_logging ;;
            8) menu_lists ;;
            9) menu_ops ;;
            10) apply_and_restart ;;
            11) clear; uci show killswitch; echo; read -r -p "$(t press_enter)" d ;;
            12) show_artifact_info ;;
            13) menu_lang ;;
            0) echo "$(t exit_msg)"; break ;;
        esac
    done
}

load_config
main_menu
