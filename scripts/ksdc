# ksdc — интерактивный TUI-конфигуратор для ksd (Go-версия killswitch).
# Устанавливается в /usr/bin/ksdc.
# Управляет /etc/config/killswitch через UCI.
# Все операции — через /usr/sbin/ksd <cmd> -config /etc/config/killswitch
#
# Язык интерфейса: en (по умолчанию) / ru / zh.
# Выбор сохраняется в /etc/ksd-lang (НЕ в UCI — чтобы не мешать ksd).
# Добавить язык: определить T_<key>_<lang> и добавить код в case ниже + в menu_lang.
# Если перевода нет — используется английский (fallback).
#
# Что убрано из shell-версии (в ksd этого нет):
#   semantic_verify_enabled, cache_file, cache_ttl_hours, cache_hard_ttl_hours,
#   empty_source_threshold, monitoring_enabled, monitoring_interval_minutes,
#   monitor_after_stop, reset_checksum_on_change
# Что добавлено (есть в ksd):
#   poll_interval_sec, verify_interval_sec, empty_source_grace_sec,
#   full_fail_max, max_vps_elements, flush_on_narrow_only, merge_static_vps,
#   log_max_kb, force_stop, arp_protection (плоские опции)

KSD="/usr/sbin/ksd"
CONFIG="/etc/config/killswitch"
INIT="/etc/init.d/ksd"
LANG_FILE="/etc/ksd-lang"

if [ -t 1 ]; then
    RED=$(printf '\033[31m');   GREEN=$(printf '\033[32m')
    YELLOW=$(printf '\033[33m'); BLUE=$(printf '\033[34m')
    MAGENTA=$(printf '\033[35m'); CYAN=$(printf '\033[36m')
    BOLD=$(printf '\033[1m');    DIM=$(printf '\033[2m')
    RESET=$(printf '\033[0m')
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; MAGENTA=""; CYAN=""
    BOLD=""; DIM=""; RESET=""
fi

# ─── Валидаторы ─────────────────────────────────────────

validate_ip_plain() {
    echo "$1" | grep -qE '^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$'
}
validate_ip_cidr() {
    echo "$1" | grep -qE '^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(/(3[0-2]|[12]?[0-9]))?$'
}
validate_mac() {
    echo "$1" | grep -qiE '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'
}
validate_priority() {
    echo "$1" | grep -qE '^-?[0-9]+$'
}
validate_positive_int() {
    echo "$1" | grep -qE '^[1-9][0-9]*$'
}
validate_source_set() {
    echo "$1" | grep -qE '^inet [a-zA-Z_][a-zA-Z0-9_]* [a-zA-Z_][a-zA-Z0-9_]*$'
}

# ─── i18n: движок ───────────────────────────────────────

UI_LANG="en"
if [ -f "$LANG_FILE" ]; then
    UI_LANG=$(head -n 1 "$LANG_FILE" 2>/dev/null | tr -d ' \t\r\n')
fi
case "$UI_LANG" in
    en|ru|zh) ;;
    *) UI_LANG="en" ;;
esac

# t KEY      — строка по ключу (fallback: en)
# tf KEY ... — строка с printf-подстановкой (%s)
t() {
    eval "printf '%s' \"\${T_$1_${UI_LANG}:-\${T_$1_en}}\""
}
tf() {
    local key="$1"; shift
    printf "$(t "$key")" "$@"
}
lang_name() {
    case "$1" in
        ru) printf 'Русский' ;;
        zh) printf '中文' ;;
        *)  printf 'English' ;;
    esac
}

