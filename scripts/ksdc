    echo "  set_name                 : ${SET_NAME}"
    echo "  source_set               : ${SOURCE_SET}"
    echo "  filter_priority          : ${FILTER_PRIO}"
    echo "  forward_filter_prio      : ${FORWARD_FILTER_PRIO}"
    echo "  mangle_priority          : ${MANGLE_PRIO}"
    echo "  ntp_servers              : ${NTP_SERVERS:-$(t ph_notset)}"
    echo ""
    echo "${BLUE}$(t sec_timing)${RESET}"
    echo "  poll_interval_sec        : ${POLL_INTERVAL}"
    echo "  verify_interval_sec      : ${VERIFY_INTERVAL}"
    echo "  empty_source_grace_sec   : ${EMPTY_GRACE}"
    echo "  full_fail_max            : ${FULL_FAIL_MAX}"
    echo "  max_vps_elements         : ${MAX_VPS}"
    echo "  flush_on_narrow_only     : ${FLUSH_NARROW}"
    echo "  merge_static_vps         : ${MERGE_STATIC}"
    echo ""
    echo "${MAGENTA}$(t sec_dns)${RESET}"
    echo "  $(t doh_label)           : ${DOH_SERVERS:-$(t ph_empty)}"
    echo ""
    echo "${RED}$(t sec_arp)${RESET}"
    echo "  arp_protection           : ${ARP_PROT}"
    echo "  arp_interface            : ${ARP_IFACE:-$(t ph_auto)}"
    echo "  arp_gateways             : ${ARP_GATEWAYS:-$(t ph_notset)}"
    echo "  arp_gateway_mac          : ${ARP_GATEWAY_MACS:-$(t ph_notset)}"
    echo ""
    echo "${YELLOW}$(t sec_logs)${RESET}"
    echo "  log_suspicious           : ${LOG_SUSP}"
    echo "  log_drops                : ${LOG_DROPS}"
    echo "  log_file                 : ${LOG_FILE:-$(t ph_notset)}"
    echo "  log_max_kb               : ${LOG_MAX_KB}"
    echo ""
    echo "${BLUE}$(t sec_lists)${RESET}"
    echo "  allowed_marks            : ${ALLOWED_MARKS}"
    echo "  allowed_interfaces       : ${ALLOWED_IFACES}"
    echo "  static_vps               : ${STATIC_VPS:-$(t ph_empty)}"
    echo ""
    echo "${BOLD}$(t sec_artifact)${RESET} $(get_artifact_hash | cut -c1-32)..."
    echo "${DIM}$(tf uci_count "$(uci -q show killswitch | wc -l)")${RESET}"
}

# ─── Изменение параметров ───────────────────────────────

set_boolean() {
    local var_name="$1" current="$2" qkey="$3" new_val choice
    echo "$(t "$qkey") $(tf current_fmt "$current")"
    echo "  $(t bool_on)"
    echo "  $(t bool_off)"
    read -r -p "$(t choice12_prompt)" choice
    case "$choice" in
        1) new_val="1" ;;
        2) new_val="0" ;;
        *) echo "$(tf keep_fmt "$current")"; return ;;
    esac
    if [ "$new_val" != "$current" ]; then
        uci set killswitch.main.${var_name}="$new_val"
        echo "${GREEN}$(tf set_ok "$var_name" "$new_val")${RESET}"
    else
        echo "$(t no_changes)"
    fi
}

set_string() {
    local var_name="$1" current="$2" pkey="$3" validator="$4" new_val
    echo "$(t "$pkey") $(tf current_fmt "${current:-$(t ph_empty)}")"
    while true; do
        read -r -p "$(t new_value_prompt)" new_val
        [ -z "$new_val" ] && return
        if [ -n "$validator" ]; then
            if $validator "$new_val"; then break
            else echo "${RED}$(t invalid_format)${RESET}"; fi
        else
            break
        fi
    done
    if [ "$new_val" != "$current" ]; then
        uci set killswitch.main.${var_name}="$new_val"
        echo "${GREEN}$(tf set_ok_q "$var_name" "$new_val")${RESET}"
    fi
}

# ─── Управление списками ────────────────────────────────

manage_list() {
    local section="$1" option="$2" ltkey="$3" validator="$4"
    local current_list

    if [ "$section" = "main" ]; then
        current_list=$(uci -q show killswitch.main.${option} | cut -d= -f2 | tr -d "'")
    elif [ "$section" = "doh" ]; then
        current_list=$(uci -q show killswitch.doh.${option} | cut -d= -f2 | tr -d "'")
    fi

    echo "${BOLD}$(tf list_current_fmt "$(t "$ltkey")")${RESET}"
    if [ -n "$current_list" ]; then
        echo "$current_list" | while read -r item; do echo "  - $item"; done
    else
        echo "  $(t ph_empty)"
    fi
    echo ""
    echo "  $(t ml_add)"
    echo "  $(t ml_del)"
    echo "  $(t ml_clear)"
    echo "  0) $(t back)"
    read -r -p "$(t ml_action)" action

    case "$action" in
        1)
            read -r -p "$(t ml_value)" new_item
            [ -z "$new_item" ] && return
            if [ -n "$validator" ] && ! $validator "$new_item"; then
                echo "${RED}$(t invalid_format)${RESET}"; return
            fi
            uci add_list killswitch.${section}.${option}="$new_item"
            echo "${GREEN}$(tf ml_added "$new_item")${RESET}"
            ;;
        2)
            [ -z "$current_list" ] && { echo "$(t ml_list_empty)"; return; }
            i=1
            echo "$current_list" | while read -r item; do
                echo "  ${i}) ${item}"; i=$((i+1))
            done
            read -r -p "$(t ml_number)" idx
            case "$idx" in ''|*[!0-9]*) echo "$(t ml_bad_number)"; return ;; esac
            local total=$(echo "$current_list" | grep -c .)
            [ "$idx" -lt 1 ] || [ "$idx" -gt "$total" ] && { echo "$(tf ml_range "$total")"; return; }
            local item=$(echo "$current_list" | sed -n "${idx}p")
            uci del_list killswitch.${section}.${option}="$item"
            echo "${GREEN}$(tf ml_removed "$idx" "$item")${RESET}"
            ;;
        3)
            uci -q delete killswitch.${section}.${option}
            echo "${GREEN}$(t ml_cleared)${RESET}"
            ;;
        0) return ;;
    esac
}

# ─── Подменю ────────────────────────────────────────────

menu_basic() {
    while true; do
        load_config
        clear
        echo "${BOLD}$(t basic_title)${RESET}"
        echo "  1) strict_mode          : ${STRICT_MODE}"
        echo "  2) dns_block_enabled    : ${DNS_BLOCK}"
        echo "  3) doh_block_enabled    : ${DOH_BLOCK}"
        echo "  4) doq_block_enabled    : ${DOQ_BLOCK}"
        echo "  5) quic_block_enabled   : ${QUIC_BLOCK}"
        echo "  6) ipv6_block_enabled   : ${IPV6_BLOCK}"
        echo "  7) forward_protect      : ${FORWARD_PROTECT}"
        echo "  8) mss_clamp_enabled    : ${MSS_CLAMP}"
        echo "  9) ttl_set_enabled      : ${TTL_SET}"
        echo " 10) force_stop           : ${FORCE_STOP}"
        echo "  0) $(t back)"
        read -r -p "$(tf choice_prompt 10)" opt
        case "$opt" in
            1) set_boolean strict_mode "$STRICT_MODE" q_strict ;;
            2) set_boolean dns_block_enabled "$DNS_BLOCK" q_dns_block ;;
            3) set_boolean doh_block_enabled "$DOH_BLOCK" q_doh_block ;;
            4) set_boolean doq_block_enabled "$DOQ_BLOCK" q_doq_block ;;
            5) set_boolean quic_block_enabled "$QUIC_BLOCK" q_quic_block ;;
            6) set_boolean ipv6_block_enabled "$IPV6_BLOCK" q_ipv6_block ;;
            7) set_boolean forward_protect "$FORWARD_PROTECT" q_forward ;;
            8) set_boolean mss_clamp_enabled "$MSS_CLAMP" q_mss_clamp ;;
            9) set_boolean ttl_set_enabled "$TTL_SET" q_ttl_set ;;
            10) set_boolean force_stop "$FORCE_STOP" q_force_stop ;;
            0) break ;;
        esac
        uci commit killswitch
    done
}

