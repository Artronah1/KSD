# ─── Артефакт ───────────────────────────────────────────

get_artifact_hash() {
    if [ -f "$KSD" ]; then
        sha256sum "$KSD" 2>/dev/null | awk '{print $1}'
    else
        echo "<ksd not found>"
    fi
}

show_artifact_info() {
    clear
    echo "${BOLD}$(t artifact_title)${RESET}"
    echo ""
    if [ ! -f "$KSD" ]; then
        echo "${RED}✗ $(tf ksd_not_found "$KSD")${RESET}"
        read -r -p "$(t press_enter)" dummy; return
    fi
    echo "${CYAN}$(tf sha_label "$KSD")${RESET}"
    echo "  $(get_artifact_hash)"
    echo ""
    echo "${DIM}$(tf size_fmt "$(wc -c < "$KSD" | tr -d ' ')")${RESET}"
    echo "${DIM}$(tf mtime_fmt "$(ls -l "$KSD" | awk '{print $6, $7, $8}')")${RESET}"
    echo ""
    echo "${CYAN}$(t version_label)${RESET}"
    $KSD version 2>/dev/null | sed 's/^/  /'
    echo ""
    read -r -p "$(t press_enter)" dummy
}

# ─── Загрузка конфига ───────────────────────────────────

load_config() {
    # Основное
    TABLE_NAME=$(uci -q get killswitch.main.table_name 2>/dev/null || echo "killswitch_table")
    SET_NAME=$(uci -q get killswitch.main.set_name 2>/dev/null || echo "vps_ipv4")
    SOURCE_SET=$(uci -q get killswitch.main.source_set 2>/dev/null || echo "inet passwall2 psw2_vps")
    WAN_IF=$(uci -q get killswitch.main.wan_interface 2>/dev/null || echo "wan")
    WAN_DEV=$(uci -q get killswitch.main.wan_device 2>/dev/null || echo "")

    STRICT_MODE=$(uci -q get killswitch.main.strict_mode 2>/dev/null || echo "1")
    DNS_BLOCK=$(uci -q get killswitch.main.dns_block_enabled 2>/dev/null || echo "1")
    DOH_BLOCK=$(uci -q get killswitch.main.doh_block_enabled 2>/dev/null || echo "1")
    DOQ_BLOCK=$(uci -q get killswitch.main.doq_block_enabled 2>/dev/null || echo "1")
    QUIC_BLOCK=$(uci -q get killswitch.main.quic_block_enabled 2>/dev/null || echo "0")
    IPV6_BLOCK=$(uci -q get killswitch.main.ipv6_block_enabled 2>/dev/null || echo "1")
    FORWARD_PROTECT=$(uci -q get killswitch.main.forward_protect 2>/dev/null || echo "1")
    MSS_CLAMP=$(uci -q get killswitch.main.mss_clamp_enabled 2>/dev/null || echo "1")
    TTL_SET=$(uci -q get killswitch.main.ttl_set_enabled 2>/dev/null || echo "0")
    FORCE_STOP=$(uci -q get killswitch.main.force_stop 2>/dev/null || echo "0")

    FILTER_PRIO=$(uci -q get killswitch.main.filter_priority 2>/dev/null || echo "-10")
    FORWARD_FILTER_PRIO=$(uci -q get killswitch.main.forward_filter_priority 2>/dev/null || echo "-15")
    MANGLE_PRIO=$(uci -q get killswitch.main.mangle_priority 2>/dev/null || echo "-150")

    POLL_INTERVAL=$(uci -q get killswitch.main.poll_interval_sec 2>/dev/null || echo "5")
    VERIFY_INTERVAL=$(uci -q get killswitch.main.verify_interval_sec 2>/dev/null || echo "60")
    EMPTY_GRACE=$(uci -q get killswitch.main.empty_source_grace_sec 2>/dev/null || echo "15")
    FULL_FAIL_MAX=$(uci -q get killswitch.main.full_fail_max 2>/dev/null || echo "3")
    MAX_VPS=$(uci -q get killswitch.main.max_vps_elements 2>/dev/null || echo "5000")
    FLUSH_NARROW=$(uci -q get killswitch.main.flush_on_narrow_only 2>/dev/null || echo "1")
    MERGE_STATIC=$(uci -q get killswitch.main.merge_static_vps 2>/dev/null || echo "0")

    LOG_SUSP=$(uci -q get killswitch.main.log_suspicious 2>/dev/null || echo "1")
    LOG_DROPS=$(uci -q get killswitch.main.log_drops 2>/dev/null || echo "0")
    LOG_FILE=$(uci -q get killswitch.main.log_file 2>/dev/null || echo "")
    LOG_MAX_KB=$(uci -q get killswitch.main.log_max_kb 2>/dev/null || echo "512")

    ARP_PROT=$(uci -q get killswitch.main.arp_protection 2>/dev/null || echo "0")
    ARP_IFACE=$(uci -q get killswitch.main.arp_interface 2>/dev/null || echo "")

    # Списки
    ALLOWED_MARKS=$(uci -q show killswitch.main.allowed_mark 2>/dev/null | cut -d= -f2 | tr -d "'" | tr '\n' ' ')
    [ -z "$ALLOWED_MARKS" ] && ALLOWED_MARKS="0x50535732 0x000000ff"

    ALLOWED_IFACES=$(uci -q show killswitch.main.allowed_iface 2>/dev/null | cut -d= -f2 | tr -d "'" | tr '\n' ' ')
    [ -z "$ALLOWED_IFACES" ] && ALLOWED_IFACES="lo br-lan"

    STATIC_VPS=$(uci -q show killswitch.main.static_vps 2>/dev/null | cut -d= -f2 | tr -d "'" | tr '\n' ' ')

    DOH_SERVERS=$(uci -q show killswitch.doh.server 2>/dev/null | cut -d= -f2 | tr -d "'" | tr '\n' ' ')

    NTP_SERVERS=$(uci -q show killswitch.main.ntp_servers 2>/dev/null | cut -d= -f2 | tr -d "'" | tr '\n' ' ')

    ARP_GATEWAYS=$(uci -q show killswitch.main.arp_gateway 2>/dev/null | cut -d= -f2 | tr -d "'" | tr '\n' ' ')
    ARP_GATEWAY_MACS=$(uci -q show killswitch.main.arp_gateway_mac 2>/dev/null | cut -d= -f2 | tr -d "'" | tr '\n' ' ')
}

