menu_ops() {
    while true; do
        clear
        echo "${BOLD}$(t ops_title)${RESET}"
        echo "  1) status"
        echo "  2) self-test"
        echo "  3) dry-run full"
        echo "  4) dry-run baseline"
        echo "  5) install (baseline → full)"
        echo "  6) reset-counters"
