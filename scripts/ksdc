show_config() {
    load_config
    clear
    echo "${BOLD}$(t config_title)${RESET}"
    echo ""
    echo "${GREEN}$(t sec_basic)${RESET}"
    echo "  strict_mode              : ${STRICT_MODE}"
    echo "  dns_block_enabled        : ${DNS_BLOCK}"
    echo "  doh_block_enabled        : ${DOH_BLOCK}"
    echo "  doq_block_enabled        : ${DOQ_BLOCK}"
    echo "  quic_block_enabled       : ${QUIC_BLOCK}"
    echo "  ipv6_block_enabled       : ${IPV6_BLOCK}"
    echo "  forward_protect          : ${FORWARD_PROTECT}"
    echo "  mss_clamp_enabled        : ${MSS_CLAMP}"
    echo "  ttl_set_enabled          : ${TTL_SET}"
