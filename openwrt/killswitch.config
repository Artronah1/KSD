# SPDX-License-Identifier: MulanPubL-2.0
# /etc/config/killswitch — example configuration for ksd.
#
# Every option below is optional; the defaults are shown. Only add what you
# actually want to change.

config killswitch 'main'
    # ---- identity ----
    option table_name      'killswitch_table'
    option set_name        'vps_ipv4'

    # ---- where VPN endpoints come from (passwall2) ----
    option source_set      'inet passwall2 psw2_vps'

    # ---- network ----
    option wan_interface   'wan'
    # option wan_device   'eth1'          # pin explicitly; skip ubus detection
    list   allowed_iface   'lo'
    list   allowed_iface   'br-lan'
    list   allowed_mark    '0x50535732'
    list   allowed_mark    '0x000000ff'

    # ---- feature switches ----
    option strict_mode        '1'   # empty endpoint set => block everything
    option dns_block_enabled  '1'
    option doq_block_enabled  '1'
    option doh_block_enabled  '1'
    option quic_block_enabled '0'
    option ipv6_block_enabled '1'
    option mss_clamp_enabled  '1'
    option ttl_set_enabled    '0'
    option forward_protect    '1'

    # ---- hook priorities ----
    option filter_priority         '-10'
    option forward_filter_priority '-15'
    option mangle_priority         '-150'

    # ---- timing (seconds) ----
    option poll_interval_sec     '5'    # how often we look at the endpoint set
    option verify_interval_sec   '60'   # how often we re-verify the ruleset
    option empty_source_grace_sec '15'  # debounce before clearing the set
    option full_fail_max         '3'    # breaker: consecutive full failures

    # ---- limits ----
    option max_vps_elements  '5000'

    # ---- behaviour ----
    option flush_on_narrow_only '1'   # only flush conntrack when the set shrinks
    option merge_static_vps     '0'   # 1 = always allow static_vps entries

    # ---- diagnostics ----
    option log_suspicious '1'
    option log_drops      '0'
    # option log_file     '/root/ksd.log'
    option log_max_kb     '512'

    # ---- removal ----
    option force_stop '0'   # 1 = delete all nft objects when ksd stops

    # ---- NTP bootstrap (needed in full mode, see review P1-8) ----
    list ntp_servers '129.6.15.28'
    list ntp_servers '132.163.97.1'

    # ---- optional: always-allowed endpoints ----
    # list static_vps '203.0.113.7'

    # ---- optional: ARP anti-spoofing ----
    option arp_protection '0'

config doh
    list server '1.1.1.1'
    list server '8.8.8.8'
    list server '9.9.9.9'

# Optional ARP anti-spoofing table. Requires arp_protection=1 in the main
# section above. Without gateway_mac only the gateway IP is validated, which
# does NOT stop spoofing — ksd logs a warning if you leave it out.
# config arp
#     option interface   'eth1'
#     list   gateway     '192.168.0.1'
#     list   gateway_mac 'aa:bb:cc:dd:ee:ff'
